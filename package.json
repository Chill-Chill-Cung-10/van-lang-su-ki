{
  "name": "van-lang-su-ki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "pnpm -r --parallel --stream dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel --stream start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d db minio minio-init mailpit adminer",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "services:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0"
  }
}
